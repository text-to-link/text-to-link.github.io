{
  "id": "/",
  "name": "Text to Link",
  "short_name": "Text to Link",
  "description": "Free text to link generator: HTML, Markdown, BBCode, highlight links and QR codes.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1117",
  "theme_color": "#0b1117",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
